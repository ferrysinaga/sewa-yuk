# Konfigurasi E2E untuk skenario realtime SYNC-01/02/03.
# Salin file ini menjadi .env.e2e lalu isi nilainya. Jangan commit .env.e2e.
#
# Prasyarat:
# - Dua akun tenant terdaftar dan sudah dikonfirmasi. Akun ini harus memiliki
#   user_metadata.role = "tenant" (atau tanpa role, karena default UI = tenant).
# - Satu akun organizer terdaftar dengan user_metadata.role = "organizer".
#   Akun organizer hanya dipakai oleh audit aksesibilitas /admin dan
#   /admin/bookings.
# - Satu blueprint berstatus "published" dengan minimal satu booth "Available".
# - Supabase Realtime aktif untuk tabel booths dan bookings.
# - Jalankan `npm run dev` di terminal lain, atau biarkan Playwright
#   menjalankan dev server otomatis.

# Opsional. Default: http://127.0.0.1:5173
E2E_BASE_URL=http://127.0.0.1:5173

E2E_TENANT_A_EMAIL=
E2E_TENANT_A_PASSWORD=

E2E_TENANT_B_EMAIL=
E2E_TENANT_B_PASSWORD=

# Akun organizer untuk audit aksesibilitas /admin dan /admin/bookings.
# Tes organizer dilewati bila dua variabel ini kosong.
E2E_ORGANIZER_EMAIL=
E2E_ORGANIZER_PASSWORD=

# ID blueprint yang dipublikasikan, misalnya hall-a
E2E_EVENT_ID=

# ID booth Available yang akan dipakai bergantian. Tes mengembalikan booth
# menjadi Available lewat pembatalan pesanan setelah selesai.
E2E_BOOTH_ID=
