# Konfigurasi E2E untuk skenario realtime SYNC-01/02/03/04.
# Salin file ini menjadi .env.e2e lalu isi nilainya. Jangan commit .env.e2e.
#
# Prasyarat:
# - Dua akun tenant terdaftar dan sudah dikonfirmasi. Akun ini harus memiliki
#   app_metadata.role = "tenant" (atau tanpa role, karena default aman =
#   tenant). user_metadata.role tidak dipakai untuk otorisasi.
# - Satu akun organizer terdaftar dengan app_metadata.role = "organizer".
#   Akun organizer hanya dipakai oleh audit aksesibilitas /admin dan
#   /admin/bookings. Lihat supabase/AUTH_ROLES.md untuk backfill.
# - Satu blueprint berstatus "published" dengan minimal satu booth "Available".
# - Supabase Realtime aktif untuk tabel booths dan bookings.
# - Jalankan `npm run dev` di terminal lain, atau biarkan Playwright
#   menjalankan dev server otomatis.

# Opsional. Default: http://127.0.0.1:5173
E2E_BASE_URL=http://127.0.0.1:5173

E2E_TENANT_A_EMAIL=
E2E_TENANT_A_PASSWORD=

E2E_TENANT_B_EMAIL=
E2E_TENANT_B_PASSWORD=

# Akun organizer untuk audit aksesibilitas /admin dan /admin/bookings.
# Tes organizer dilewati bila dua variabel ini kosong.
E2E_ORGANIZER_EMAIL=
E2E_ORGANIZER_PASSWORD=

# ID blueprint yang dipublikasikan, misalnya hall-a
E2E_EVENT_ID=

# ID booth Available yang akan dipakai bergantian. Tes mengembalikan booth
# menjadi Available lewat pembatalan pesanan setelah selesai.
E2E_BOOTH_ID=

# Opsional, HANYA staging/CI. URL dan anon key dipakai suite negatif RLS untuk
# memanggil REST sebagai anon dan menukar kredensial uji menjadi JWT. Anon key
# memang publik, tetapi tetap jangan arahkan ke produksi.
E2E_SUPABASE_URL=
E2E_SUPABASE_ANON_KEY=

# Data uji untuk suite negatif RLS (e2e/security.spec.ts). Kosongkan bila belum
# ada; tes terkait akan dilewati dengan alasan yang jelas.
# Blueprint berstatus draft yang tidak boleh dibaca tenant.
E2E_DRAFT_EVENT_ID=
# Booking milik tenant A dan tenant B untuk uji isolasi dan RPC organizer.
E2E_TENANT_A_BOOKING_ID=
E2E_TENANT_B_BOOKING_ID=
# Booth berstatus Reserved/Booked dan booth pada blueprint draft, untuk uji
# penolakan create_booking.
E2E_UNAVAILABLE_BOOTH_ID=
E2E_DRAFT_BOOTH_ID=

# Opsional, HANYA staging/CI. Service role melewati RLS dan dapat menghapus
# data uji. Jangan pernah memakai kunci produksi atau menaruhnya di frontend.
# Memakai E2E_SUPABASE_URL di atas.
#
# Bila diisi:
# - SYNC-03 menambah asersi database bahwa tepat satu booking aktif tersisa.
# - SYNC-04 mengubah expires_at lewat admin API dan mereset booth setelah tes.
# Bila kosong:
# - SYNC-03 tetap jalan dengan asersi UI; asersi database dilewati.
# - SYNC-04 dilewati dengan alasan yang jelas.
E2E_SERVICE_ROLE_KEY=
